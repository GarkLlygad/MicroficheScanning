from bs4 import BeautifulSoup

uploaders = ['dylan', 'elijah', 'fernando', 'axia', 'cameron', 'danielle', 'emmie', 'fredy', 'hope', 'jay', 'josh', 'kurt', 'maeve', 'maya', 'michael', 'miguel', 'sophia', 'annie', 'vinny', 'xane']

for i in uploaders:
    with open(f"/home/gark/MicroficheScanning/scanners/{i}.html") as fp:
        soup = BeautifulSoup(fp, 'html.parser')
        soup.find(id=f"{i}Today").string = str(0)
    with open(f"/home/gark/MicroficheScanning/scanners/{i}.html", "w") as fp:
        fp.write(soup.prettify())
